rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/rh_users/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.active == true;
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(profilePath()).data.isAdmin == true;
    }

    function canEdit(permission) {
      return isAdmin()
        || (hasActiveProfile()
          && get(profilePath()).data.perms[permission] == true);
    }

    function validAuditEntry() {
      return request.resource.data.keys().hasAll([
          'uid', 'acao', 'detalhes', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'acao', 'detalhes', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acao is string
        && request.resource.data.acao.size() > 0
        && request.resource.data.acao.size() <= 80
        && request.resource.data.detalhes is string
        && request.resource.data.detalhes.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }

    function currentValeStatusVersion() {
      return resource.data.keys().hasAll(['statusVersion'])
          && resource.data.statusVersion is int
          && resource.data.statusVersion >= 0
        ? resource.data.statusVersion
        : 0;
    }

    function currentValeStatus() {
      return resource.data.keys().hasAll(['status'])
          && resource.data.status == 'PENDENTE'
        ? 'PENDENTE'
        : 'PAGO';
    }

    function validNewPayment() {
      return request.resource.data.tipo != 'Vale'
        || (request.resource.data.status in ['PENDENTE', 'PAGO']
          && !request.resource.data.keys().hasAny([
            'statusVersion', 'statusUpdatedAt', 'statusUpdatedBy'
          ]));
    }

    function preservesValeStatusControl() {
      return resource.data.tipo != 'Vale'
        || (request.resource.data.tipo == 'Vale'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'statusVersion', 'statusUpdatedAt', 'statusUpdatedBy'
          ]));
    }

    function validVersionedValeStatusUpdate() {
      return resource.data.tipo == 'Vale'
        && request.resource.data.tipo == 'Vale'
        && request.resource.data.status in ['PENDENTE', 'PAGO']
        && request.resource.data.status != currentValeStatus()
        && request.resource.data.statusVersion == currentValeStatusVersion() + 1
        && request.resource.data.statusUpdatedAt == request.time
        && request.resource.data.statusUpdatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'statusVersion', 'statusUpdatedAt', 'statusUpdatedBy'
        ]);
    }

    function validPaymentUpdate() {
      return request.resource.data.tipo == resource.data.tipo
        && (preservesValeStatusControl() || validVersionedValeStatusUpdate());
    }

    match /rh_users/{uid} {
      allow get: if hasActiveProfile()
        && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /rh_funcionarios/{documentId} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if canEdit('func');
    }

    match /rh_presencas/{documentId} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if canEdit('pres');
    }

    match /rh_pagamentos/{documentId} {
      allow read: if hasActiveProfile();
      allow create: if canEdit('fin') && validNewPayment();
      allow update: if canEdit('fin') && validPaymentUpdate();
      allow delete: if canEdit('fin');
    }

    match /rh_extras/{documentId} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if canEdit('fin');
    }

    match /rh_entregas/{documentId} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if canEdit('moto');
    }

    match /rh_boletos/{documentId} {
      allow read: if hasActiveProfile();
      allow create, update, delete: if canEdit('boletos');
    }

    match /rh_audit/{documentId} {
      allow read: if isAdmin();
      allow create: if hasActiveProfile() && validAuditEntry();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
